# Copiar este archivo a .env y completar los datos antes de arrancar.
# No subir .env a Git. Usar formato NOMBRE=valor, sin comillas ni "export".
# Mantener los valores de la base existente si ya se habia inicializado.
POSTGRES_DB=campushub
POSTGRES_USER=elige_un_usuario
POSTGRES_PASSWORD=elige_una_contrasena
